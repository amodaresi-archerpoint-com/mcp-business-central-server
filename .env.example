# --- BC connection ---
# SaaS example:
#   https://api.businesscentral.dynamics.com/v2.0/{tenant-id}/{environment}/api/v2.0
# Custom API page example:
#   https://api.businesscentral.dynamics.com/v2.0/{tenant-id}/{environment}/api/{publisher}/{group}/v2.0
# On-prem example:
#   https://bc.contoso.local:7048/BC/api/v2.0
BC_BASE_URL=

# Default company name OR GUID. Tools accept a `company` arg to override.
BC_COMPANY=

# --- Auth ---
# oauth_client_credentials  (recommended for SaaS)
# basic                     (on-prem or SaaS Web Service Access Key)
BC_AUTH_TYPE=oauth_client_credentials

# OAuth (S2S) — required when BC_AUTH_TYPE=oauth_client_credentials
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
# Override only if your environment uses a different scope.
# BC_SCOPE=https://api.businesscentral.dynamics.com/.default

# Basic auth — required when BC_AUTH_TYPE=basic
# BC_USER=
# BC_PASS=

# --- Behavior ---
# Disable all write tools (create/update/delete/invoke).
BC_READ_ONLY=false

# Require `confirm: true` on every write tool call.
BC_REQUIRE_WRITE_CONFIRMATION=true

# Metadata cache TTL in seconds. 0 disables.
BC_METADATA_CACHE_TTL_SEC=3600

# Per-request timeout.
BC_REQUEST_TIMEOUT_MS=30000

# ON-PREM ONLY: set to false to skip TLS verification (self-signed certs).
# DO NOT set this for SaaS.
BC_REJECT_UNAUTHORIZED=true
