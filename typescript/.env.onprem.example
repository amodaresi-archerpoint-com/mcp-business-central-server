# Business Central on-prem connection
# Replace the values below with your actual credentials

# Endpoint family. Auto-detected from BC_BASE_URL; set explicitly to override.
#   api   -> /api/v2.0 root. Reaches API pages and API queries only.
#   odata -> /ODataV4 root. Reaches anything published on the Web Services
#            page (pages and queries), including ISV and custom tables that
#            have no API page. Requires no AL code — just publish the page.
# BC_ENDPOINT_STYLE=odata

# ...with the api style:
BC_BASE_URL=https://YOUR-BC-SERVER:7048/BC/api/v2.0
# ...or with the odata style (note: no version segment):
# BC_BASE_URL=https://YOUR-BC-SERVER:7048/BC/ODataV4

# Company GUID (preferred — immutable) or exact name. On the odata style the
# name is CASE-SENSITIVE and is not resolved server-side.
BC_COMPANY=CRONUS International Ltd.

BC_AUTH_TYPE=basic
BC_USER=YOUR_BC_USERNAME
BC_PASS=YOUR_BC_WEB_SERVICE_ACCESS_KEY

# Safety mode — set to true to block all write operations
BC_READ_ONLY=false

# Require confirm:true on every write call (recommended)
BC_REQUIRE_WRITE_CONFIRMATION=true

# Metadata cache TTL in seconds
BC_METADATA_CACHE_TTL_SEC=3600

# Request timeout
BC_REQUEST_TIMEOUT_MS=30000

# Valid TLS cert — leave true for trusted certificates
BC_REJECT_UNAUTHORIZED=true
