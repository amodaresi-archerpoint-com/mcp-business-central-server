# Business Central on-prem connection
# Replace the values below with your actual credentials

BC_BASE_URL=https://YOUR-BC-SERVER:7048/BC/api/v2.0
BC_COMPANY=CRONUS International Ltd.

BC_AUTH_TYPE=basic
BC_USER=YOUR_BC_USERNAME
BC_PASS=YOUR_BC_WEB_SERVICE_ACCESS_KEY

# Safety mode — set to true to block all write operations
BC_READ_ONLY=false

# Require confirm:true on every write call (recommended)
BC_REQUIRE_WRITE_CONFIRMATION=true

# Metadata cache TTL in seconds
BC_METADATA_CACHE_TTL_SEC=3600

# Request timeout
BC_REQUEST_TIMEOUT_MS=30000

# Valid TLS cert — leave true for trusted certificates
BC_REJECT_UNAUTHORIZED=true
